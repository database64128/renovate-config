{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Renovate configuration for .NET projects",
    "extends": [
        "github>database64128/renovate-config"
    ],
    "packageRules": [
        {
            "matchPackageNames": [
                "/^System.CommandLine/"
            ],
            "groupName": "System.CommandLine"
        },
        {
            "matchPackageNames": [
                "/^Reactive(UI|Marbles)/"
            ],
            "groupName": "ReactiveUI"
        }
    ]
}
