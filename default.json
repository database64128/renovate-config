{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Default language-agnostic Renovate configuration",
    "commitMessagePrefix": "🔼",
    "extends": [
        "config:recommended",
        ":automergeBranch",
        ":automergeDigest",
        ":automergeMinor",
        ":disableRateLimiting"
    ],
    "packageRules": [
        {
            "matchDepTypes": [
                "action"
            ],
            "versioning": "docker"
        }
    ]
}
